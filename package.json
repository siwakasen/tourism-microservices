{
  "name": "tourism-microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "dev": "concurrently \"pnpm start:employees-service:dev\" \"pnpm start:travel-packages-service:dev\" \"pnpm start:rent-car-service:dev\" \"pnpm start:expenses-service:dev\" \"pnpm start:customer-service:dev\" \"pnpm start:transaction-service:dev\" \"pnpm start:report-service:dev\" \"pnpm start:live-chat-service:dev\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs",
    "start:travel-packages-service:dev": "cross-env NODE_ENV=development nest start travel-packages-service --watch",
    "start:travel-packages-service:prod": "cross-env NODE_ENV=production nest start travel-packages-service --watch",
    "start:employees-service:dev": "cross-env NODE_ENV=development nest start employees-service --watch",
    "start:employees-service:prod": "cross-env NODE_ENV=production nest start employees-service --watch",
    "start:rent-car-service:dev": "cross-env NODE_ENV=development nest start rent-car-service --watch",
    "start:rent-car-service:prod": "cross-env NODE_ENV=production nest start rent-car-service --watch",
    "start:expenses-service:dev": "cross-env NODE_ENV=development nest start expenses-service --watch",
    "start:expenses-service:prod": "cross-env NODE_ENV=production nest start expenses-service --watch",
    "start:customer-service:dev": "cross-env NODE_ENV=development nest start customer-service --watch",
    "start:customer-service:prod": "cross-env NODE_ENV=production nest start customer-service --watch",
    "start:transaction-service:dev": "cross-env NODE_ENV=development nest start transaction-service --watch",
    "start:transaction-service:prod": "cross-env NODE_ENV=production nest start transaction-service --watch",
    "start:live-chat-service:dev": "cross-env NODE_ENV=development nest start live-chat-service --watch",
    "start:live-chat-service:prod": "cross-env NODE_ENV=production nest start live-chat-service --watch",
    "start:report-service:dev": "cross-env NODE_ENV=development nest start report-service --watch",
    "build:employees-service": "nest build employees-service",
    "build:employees-service:prod": "cross-env NODE_ENV=production nest build employees-service",
    "build:travel-packages-service": "nest build travel-packages-service",
    "build:travel-packages-service:prod": "cross-env NODE_ENV=production nest build travel-packages-service",
    "build:rent-car-service": "nest build rent-car-service",
    "build:rent-car-service:prod": "cross-env NODE_ENV=production nest build rent-car-service",
    "build:expenses-service": "nest build expenses-service",
    "build:expenses-service:prod": "cross-env NODE_ENV=production nest build expenses-service",
    "build:customer-service": "nest build customer-service",
    "build:customer-service:prod": "cross-env NODE_ENV=production nest build customer-service",
    "build:transaction-service": "nest build transaction-service",
    "build:transaction-service:prod": "cross-env NODE_ENV=production nest build transaction-service",
    "build:report-service:prod": "cross-env NODE_ENV=production nest build report-service",
    "build:live-chat-service": "nest build live-chat-service",
    "build:live-chat-service:prod": "cross-env NODE_ENV=production nest build live-chat-service"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.20",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/platform-socket.io": "^11.1.8",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^11.1.8",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.6",
    "@types/multer": "^1.4.13",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^4.21.2",
    "ioredis": "^5.8.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.7",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.27",
    "typeorm-extension": "^3.7.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@types/express": "^5.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.23",
    "@types/supertest": "^6.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "midtrans-client": "^1.4.3",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@nestjs/core"
    ]
  }
}
