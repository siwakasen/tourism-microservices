{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "./",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": true,
    "tsConfigPath": "tsconfig.app.json"
  },
  "monorepo": true,
  "root": "./apps",
  "projects": {
    "travel-packages-service": {
      "type": "application",
      "root": "apps/travel-packages-service/src",
      "entryFile": "main",
      "sourceRoot": "apps/travel-packages-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/travel-packages-service/tsconfig.app.json",
        "assets": [
          {
            "include": "common/envs/*.env",
            "outDir": "dist/apps/travel-packages-service/src/common/helper"
          }
        ]
      }
    },
    "employees-service": {
      "type": "application",
      "root": "apps/employees-service/src",
      "entryFile": "main",
      "sourceRoot": "apps/employees-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/employees-service/tsconfig.app.json",
        "assets": [
          {
            "include": "common/envs/*.env",
            "outDir": "dist/apps/employees-service/src/common/helper"
          }
        ]
      }
    },
    "entities": {
      "type": "library",
      "root": "libs/entities",
      "entryFile": "index",
      "sourceRoot": "libs/entities/src",
      "compilerOptions": {
        "tsConfigPath": "libs/entities/tsconfig.lib.json"
      }
    },
    "rent-car-service": {
      "type": "application",
      "root": "apps/rent-car-service/src",
      "entryFile": "main",
      "sourceRoot": "apps/rent-car-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/rent-car-service/tsconfig.app.json",
        "assets": [
          {
            "include": "common/envs/*.env",
            "outDir": "dist/apps/rent-car-service/src/common/helper"
          }
        ]
      }
    },
    "expenses-service": {
      "type": "application",
      "root": "apps/expenses-service/src",
      "entryFile": "main",
      "sourceRoot": "apps/expenses-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/expenses-service/tsconfig.app.json",
        "assets": [
          {
            "include": "common/envs/*.env",
            "outDir": "dist/apps/expenses-service/src/common/helper"
          }
        ]
      }
    },
    "customer-service": {
      "type": "application",
      "root": "apps/customer-service/src",
      "entryFile": "main",
      "sourceRoot": "apps/customer-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/customer-service/tsconfig.app.json",
        "assets": [
          {
            "include": "common/envs/*.env",
            "outDir": "dist/apps/customer-service/src/common/helper"
          }
        ]
      }
    },
    "report-service": {
      "type": "application",
      "root": "apps/report-service",
      "entryFile": "main",
      "sourceRoot": "apps/report-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/report-service/tsconfig.app.json"
      }
    },
    "live-chat-service": {
      "type": "application",
      "root": "apps/live-chat-service",
      "entryFile": "main",
      "sourceRoot": "apps/live-chat-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/live-chat-service/tsconfig.app.json"
      }
    },
    "transaction-service": {
      "type": "application",
      "root": "apps/transaction-service",
      "entryFile": "main",
      "sourceRoot": "apps/transaction-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/transaction-service/tsconfig.app.json"
      }
    }
  }
}